{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // XP runtime globals (resolve, app, log, __, ...) — vp pack does the emit.
    "types": ["@enonic-types/global"],
    // Type the absolute XP requires; vp pack keeps them external at build time.
    "paths": {
      "/lib/xp/core": ["../../../node_modules/@enonic-types/core"],
      // No @enonic-types package exists for lib-event at 8.x.
      "/lib/xp/event": ["./types/event.d.ts"],
      "/lib/xp/*": ["../../../node_modules/@enonic-types/lib-*"],
      "/lib/mustache": ["./types/mustache.d.ts"],
      "/lib/*": ["./lib/*"]
    }
  },
  "include": ["./**/*.ts", "../../test/types/**/*.d.ts"],
  "exclude": ["assets/**"]
}
