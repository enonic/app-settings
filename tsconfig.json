{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact", // JSX compiles to preact/jsx-runtime
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true, // matches per-file transpile (rolldown)
    "noEmit": true, // TS type-checks only; rolldown does the emit
    // @enonic/ui is Preact — map the React types to preact/compat so its
    // components type-check in our .tsx (mirrors the Vite alias).
    "paths": {
      "react": ["./node_modules/preact/compat"],
      "react-dom": ["./node_modules/preact/compat"],
      "react-dom/client": ["./node_modules/preact/compat"]
    }
  },
  "include": ["src/main/resources/assets/js", "vite.config.ts"]
}
